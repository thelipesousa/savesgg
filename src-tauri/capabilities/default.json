{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "allow-scan",
    "allow-list-destinations-cmd",
    "allow-add-custom-folder",
    "allow-pick-folder",
    "allow-backup-now",
    "allow-list-snapshots",
    "allow-plan-restore",
    "allow-apply-restore",
    "allow-confirm-heuristic",
    "allow-app-version",
    "allow-copy-all-to",
    "notification:default"
  ]
}